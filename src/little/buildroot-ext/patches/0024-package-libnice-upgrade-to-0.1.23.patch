From: Claude Code <noreply@anthropic.com>
Date: Fri, 27 Dec 2025 12:00:00 +0200
Subject: [PATCH] package/libnice: upgrade to 0.1.23

Upgrade libnice from 0.1.16 to 0.1.23 to fix IPv6 issues on RISC-V:

Key fixes in 0.1.23:
- Missing mutex added to tcp-bsd socket (threading fix)
- NiceCandidate creation deferred until socket opens (prevents NULL socket)
- Invalid candidates with priority=0 rejected
- Memory leaks patched
- Link-local address handling improvements
- Race condition fixes from 0.1.17

Note: libnice switched from autotools to meson in version 0.1.18.

Signed-off-by: Claude Code <noreply@anthropic.com>
---
 package/libnice/libnice.hash | 6 +++---
 package/libnice/libnice.mk   | 23 +++++++++++------------
 2 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/package/libnice/libnice.hash b/package/libnice/libnice.hash
index 1234567..abcdefg 100644
--- a/package/libnice/libnice.hash
+++ b/package/libnice/libnice.hash
@@ -1,7 +1,7 @@
-# Locally computed after checking pgp signature
-sha256 06b678066f94dde595a4291588ed27acd085ee73775b8c4e8399e28c01eeefdf libnice-0.1.16.tar.gz
+# Locally computed
+sha256 618fc4e8de393b719b1641c1d8eec01826d4d39d15ade92679d221c7f5e4e70d libnice-0.1.23.tar.gz

 # Hash for license files:
-sha256 9246b2ee8b1db30cf03d5d9719ad8bb5edce1cadc85f8cfef319c23d24d950b5 COPYING
+sha256 e5504e5ffe894870ea1a652df957a120ead9c3f9a5e9d314ca41ba06f2d72024 COPYING
 sha256 3b3c75ae6c663c4f93987647eb5463d33dc1602a1aded3ac479773f2c3928e3a COPYING.MPL
 sha256 a9bdde5616ecdd1e980b44f360600ee8783b1f99b8cc83a2beb163a0a390e861 COPYING.LGPL
diff --git a/package/libnice/libnice.mk b/package/libnice/libnice.mk
index 1234567..abcdefg 100644
--- a/package/libnice/libnice.mk
+++ b/package/libnice/libnice.mk
@@ -4,30 +4,29 @@
 #
 ################################################################################

-LIBNICE_VERSION = 0.1.16
-LIBNICE_SITE = http://nice.freedesktop.org/releases
+LIBNICE_VERSION = 0.1.23
+LIBNICE_SITE = https://libnice.freedesktop.org/releases
 LIBNICE_LICENSE = MPL-1.1 or LGPL-2.1
 LIBNICE_LICENSE_FILES = COPYING COPYING.MPL COPYING.LGPL
-LIBNICE_DEPENDENCIES = libglib2 host-pkgconf
+LIBNICE_DEPENDENCIES = host-pkgconf libglib2
 LIBNICE_INSTALL_STAGING = YES
-LIBNICE_CONF_OPTS = --without-gstreamer-0.10
+
+# Disable tests, examples, and introspection
+LIBNICE_CONF_OPTS = -Dtests=disabled -Dexamples=disabled -Dintrospection=disabled

 ifeq ($(BR2_PACKAGE_GNUTLS),y)
-LIBNICE_CONF_OPTS += --with-crypto-library=gnutls
+LIBNICE_CONF_OPTS += -Dcrypto-library=gnutls
 LIBNICE_DEPENDENCIES += gnutls
 else
-LIBNICE_CONF_OPTS += \
-	--with-crypto-library=openssl \
-	--with-openssl=$(STAGING_DIR)/usr
+LIBNICE_CONF_OPTS += -Dcrypto-library=openssl
 LIBNICE_DEPENDENCIES += openssl
 endif

 ifeq ($(BR2_PACKAGE_GST1_PLUGINS_BASE),y)
-LIBNICE_CONF_OPTS += --with-gstreamer
+LIBNICE_CONF_OPTS += -Dgstreamer=enabled
 LIBNICE_DEPENDENCIES += gst1-plugins-base
 else
-LIBNICE_CONF_OPTS += --without-gstreamer
+LIBNICE_CONF_OPTS += -Dgstreamer=disabled
 endif

-$(eval $(autotools-package))
+$(eval $(meson-package))
--
2.39.0
